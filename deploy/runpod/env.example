# vid2sim-v2 host-pipeline environment.
# Copy to `.env` on the pod and `set -a; . ./.env; set +a` before running,
# or export the ones you need. NONE of these are required for the core
# front-end (input -> observed cloud -> TSDF -> gate -> assemble -> serve);
# that path needs only the CUDA GPU.

# --- code layout (must match bootstrap.sh) ---------------------------------
export PYTHONPATH=src

# --- Optional: PoinTr middle band (local GPU) ------------------------------
# Only needed if you enabled SETUP_POINTR=1 and want learned completion.
# See STATUS.md: completion degrades well-observed objects — optional.
export POINTR_HOME=/workspace/PoinTr
export VID2SIM_COMPLETION_MODEL=pointr     # or pointr_sn55 (convention-matched)
export VID2SIM_PCA_ALIGN=1                  # 0 to disable yaw canonicalisation
export VID2SIM_LOCAL_GPU=1                  # 0 to force the CPU Poisson fallback

# --- Optional: TripoSG image-to-3D generative band (local GPU) -------------
# Set up by SETUP_TRIPOSG=1 bootstrap (or deploy/runpod/setup_triposg.sh).
# Generative-routed objects regenerate from a staged crop instead of dropping.
export VID2SIM_TRIPOSG_HOME=/workspace/TripoSG
# export VID2SIM_TRIPOSG_WEIGHTS=$VID2SIM_TRIPOSG_HOME/pretrained_weights/TripoSG
# export VID2SIM_RMBG_WEIGHTS=$VID2SIM_TRIPOSG_HOME/pretrained_weights/RMBG-1.4
export VID2SIM_TRIPOSG_STEPS=50            # fewer = faster, rougher
export VID2SIM_TRIPOSG_CFG=7.0
export VID2SIM_TRIPOSG_SEED=42

# --- Step 8 physics inference (Claude) — remote API, NOT GPU ---------------
# Leave blank to skip the VLM step (assembler falls back to the lookup table).
export ANTHROPIC_API_KEY=

# --- Step 6 generative bottom band via a SEPARATE RunPod serverless endpoint
# Leave unset to skip generation; the host pipeline still runs TSDF/gate.
# (This is the OTHER, image-to-3D RunPod usage — not this host pod.)
export RUNPOD_API_KEY=
export RUNPOD_GEN_ENDPOINT_ID=
export RUNPOD_COMPLETION_ENDPOINT_ID=
export RUNPOD_GEN_MODEL=triposg            # tiers 1-2; hunyuan3d for 3-4
export RUNPOD_COMPLETION_MODEL=pointr
