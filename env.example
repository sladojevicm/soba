# Soba — local environment template (developer machine / CI).
# Copy to `.env` (gitignored) and export it: `set -a; . ./.env; set +a`.
# Every value is optional; the core path (bundle -> TSDF -> gate -> assemble
# -> serve) runs with none of them set. Never commit a filled-in copy.
# The pod-side template with GPU model paths is deploy/runpod/env.example.
# Full inventory of every variable: docs/security/secrets-audit.md.

# ---- Secrets (blank here; real values only in your local .env) ------------
# Anthropic key for the Step-8 VLM physics backend (src/scene/vlm_claude.py);
# read implicitly by the anthropic SDK. Blank -> lookup-table fallback.
ANTHROPIC_API_KEY=
# RunPod serverless key; sent as a bearer token by src/reconstruction/generative.py.
RUNPOD_API_KEY=
# RunPod image-to-3D endpoint id (alias: RUNPOD_ENDPOINT_ID). Blank -> no RunPod.
RUNPOD_GEN_ENDPOINT_ID=
# RunPod shape-completion endpoint id (optional; completion stays local without it).
RUNPOD_COMPLETION_ENDPOINT_ID=

# ---- RunPod behaviour -------------------------------------------------------
# Generative model on the RunPod endpoint: triposg (tiers 1-2) or hunyuan3d (3-4).
RUNPOD_GEN_MODEL=
# Completion model on the RunPod endpoint (default pointr).
RUNPOD_COMPLETION_MODEL=
# Per-call timeout in seconds for runsync (default 900).
SOBA_RUNPOD_TIMEOUT=
# DEV ONLY: full runsync URL override for a tunnelled local test server.
# The bearer token is sent to whatever host this names — leave blank otherwise.
SOBA_RUNPOD_URL=

# ---- VLM physics (Step 8) ---------------------------------------------------
# 0 disables the Claude backend even when ANTHROPIC_API_KEY is set.
SOBA_VLM=
# Model override, e.g. the config's cost_option claude-haiku-4-5.
SOBA_VLM_MODEL=

# ---- Server (src/server.py) -------------------------------------------------
# Scene directory served when create_app() gets no argument.
SOBA_SCENE_DIR=
# Seconds between SSE demo events (default 0 = none).
SOBA_SSE_DELAY=

# ---- Local GPU engines (ignored on a box without CUDA) ----------------------
# 0 forces the CPU Poisson fallback even if a CUDA GPU is visible.
SOBA_LOCAL_GPU=
# Local generative model override: triposg | hunyuan3d (else per-tier default).
SOBA_GEN_MODEL=
# Local completion model override: patchcomplete | pointr | pointr_sn55 | compc.
SOBA_COMPLETION_MODEL=
# Checkouts + weights (defaults under ~/soba/...).
SOBA_TRIPOSG_HOME=
SOBA_HUNYUAN_HOME=
SOBA_PATCHCOMPLETE_HOME=
SOBA_MAST3R_HOME=
# MASt3R frame stride (default 3) and anchor-image memory cap (default 24).
SOBA_MAST3R_STRIDE=
SOBA_MAST3R_MAX_IMAGES=
# Command template for the ComPC subprocess runner; must contain {input} and
# {output}. Trusted operators only — it is executed as given.
SOBA_COMPC_CMD=

# ---- Debug switches ---------------------------------------------------------
# 1 dumps per-object PLY clouds next to the assembled scene.
SOBA_DUMP_PLY=
# 0 disables placement de-overlap in the assembler.
SOBA_DEOVERLAP=
